{
  "name": "chat-ak12",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "launch": "node --disable-warning=ExperimentalWarning scripts/launch.ts",
    "typecheck": "tsc -p web && tsc -p server",
    "test": "node --disable-warning=ExperimentalWarning --test server/*.test.ts",
    "package": "node --disable-warning=ExperimentalWarning scripts/package.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
