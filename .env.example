# Copy to .env and change what you need. Everything here is optional.

SERVER_PORT=3001
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/bartowski/TheDrummer_Rocinante-X-12B-v1-GGUF:Q5_K_M
TEMPERATURE=1
# 1: send the character sheet in the first message (for models trained without system prompts).
# 0: send it as a system prompt.
FOLD_SYSTEM_PROMPT=1
# Finds her game lines (characters/<name>/lines.json) for each message. Empty turns this off.
EMBED_MODEL=nomic-embed-text
# How long Ollama keeps the model loaded between messages (reloading takes ~30s).
OLLAMA_KEEP_ALIVE=30m

# Context window given to the model, in tokens.
NUM_CTX=8192
# Longest reply, in tokens; also the room kept free for it in the context window.
REPLY_TOKENS=1024
# Past this many tokens, older messages are folded into a summary.
HISTORY_TOKEN_LIMIT=3000
# Recent messages never summarized.
KEEP_RECENT_MESSAGES=10

# Folder name under characters/.
CHARACTER=ak12
